prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: zstreamer-elements
Description: Official elements for the zstreamer multimedia streaming framework
Version: @PROJECT_VERSION@
Requires: zstreamer
Requires.private: libavformat libavcodec libavutil x264 alsa libv4l2 libswscale libswresample freetype2 x11
Libs: -L${libdir} -lzstreamer-elements
Cflags: -I${includedir}/zstreamer -I${includedir}
