static zst_result_t
test_mixer_sink_push(zst_pad_t* pad, zst_buffer_t* buf)
{
    (void)pad;
    zst_buffer_t** out_buf = (zst_buffer_t**)pad->priv;
    if (out_buf) {
        *out_buf = buf;
    } else {
        zst_buffer_unref(buf);
    }
    return ZST_OK;
}

