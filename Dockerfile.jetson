FROM nvcr.io/nvidia/l4t-base:r32.7.1 AS base

ENV DEBIAN_FRONTEND=noninteractive

# ── Build dependencies ──────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*


# ── Multimedia libraries (for element plugins) ──────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    libv4l-dev \
    libx264-dev \
    libavformat-dev \
    libavcodec-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libasound2-dev \
    libfreetype-dev \
    libsrt-gnutls-dev \
    libgnutls28-dev \
    nettle-dev \
    libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*

# Jetson specifically needs multimedia API packages if available, but l4t-base should have nvbuf_utils.

# ── Copy source & build ─────────────────────────────────────────────────
WORKDIR /workspace
COPY . .

RUN mkdir -p build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTS=ON -DENABLE_JETSON=ON && \
    make -j$(nproc)

FROM base AS ci
WORKDIR /workspace/build
CMD ["ctest", "--output-on-failure"]
